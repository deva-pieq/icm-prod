# Used as Playwright baseURL (override per machine)
BASE_URL=https://icm.pieq.ai/

# Login credentials (required for @smoke-prod and @user-management — without these, tests are skipped)
# Default Ops Manager — smoke, dashboards, commission modules, happy-flow, etc.
# Ops-manager email comes from E2E_EMAIL (fallback LOGIN_VALID_EMAIL).
# E2E_EMAIL_ADVANCE and E2E_EMAIL_AGENCY3 override it if set (no hardcoded identity).
# @TEST-092-smoke-PROD (statement processing) and payment-module use E2E_EMAIL_AGENCY3 when set.
E2E_EMAIL=deva.r+prod+ops@pieq.ai
# Agent role smoke (@smoke-role @agent)
E2E_EMAIL_AGENT=deva.r+prod+ag+5@pieq.ai
# Agency owner dashboard smoke (@smoke-role @owner)
E2E_EMAIL_OWNER=deva.r+prod+agown@pieq.ai
# Sales Leader dashboard regression (@sales-leader-dashboard)
E2E_EMAIL_SALES_LEADER=deva.r+prod+sl@pieq.ai
E2E_PASSWORD=Test@123

# Reports: each run is saved under results/runs/{ISO-timestamp}/ and copied to results/archive/{ISO-timestamp}/
# After tests: yarn report:list | yarn report:open | yarn report:open:failed | yarn report:open -- <runId>

# Optional: set to 1, true, or yes so yarn test:cucumber opens cucumber-report/index.html after a successful run
# OPEN_CUCUMBER_REPORT=1

# Optional: custom smoke screenshots (attachSmokeScreenshot) — local only
# TAKE_SCREENSHOTS=true
# Optional: verbose step logging (fileId capture/click, assertion actual vs expected)
# DEBUG_STEPS=true
# CI: GitHub sets CI=true → TAKE_SCREENSHOTS + DEBUG_STEPS forced off; Slack still posts.
# Optional explicit flag (workflow only — do not enable locally):
# E2E_CI_MODE=1

# Optional: seconds to wait after tests finish (per worker) before closing the browser — only when using --headed
# BROWSER_IDLE_BEFORE_CLOSE_SEC=5

# Slack notification (posts a run summary after every playwright run).
# Leave blank to disable — the reporter silently skips when either value is empty.
# Bot token needs chat:write (+ files:write to attach index.html / zip). Invite the bot to the channel.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C0123ABCXYZ
# Optional: 1 / true / yes — skip Slack while debugging (leave credentials set)
# SLACK_DISABLED=1
# Optional: 1 / true / yes — only post when there are failures
# SLACK_NOTIFY_ON_FAILURE_ONLY=0
# Optional: 1 / true / yes — zip playwright-report into previousReports/ and attach it.
# Only runs when Slack reporting is active (token+channel set, SLACK_DISABLED off). Needs files:write to upload.
# SLACK_UPLOAD_ZIP=1
# Optional: local archive folder for report zips (default: previousReports)
# PREVIOUS_REPORTS_DIR=previousReports
# Optional: override the auto tag (default "<folder> <env>")
# REPORT_TAG=icm prod
# REPORT_ENV=prod
# Optional: hosted HTML report base URL for a clickable Slack link
# REPORT_BASE_URL=

# ── Gmail App Password — agent activation email polling ────────────────
# GMAIL_USER must be the plain account address (no +alias, no dots added).
# GMAIL_APP_PASSWORD is the 16-char Google App Password (spaces removed).
# Get it: https://myaccount.google.com/apppasswords  (2FA must be ON).
GMAIL_USER=deva.r@pieq.ai
GMAIL_APP_PASSWORD=
